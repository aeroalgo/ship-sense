{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "omniroute/cx/gpt-5.6-luna",
  "instructions": [
    ".kilo/instructions/bootstrap.md",
    ".kilo/instructions/workflow-gate.md",
    ".kilo/instructions/spawn-hard.md"
  ],
  "agent": {
    "code": {
      "description": "Primary implementer. L1–L2 self; verify before FINISH; spawn only per spawn-hard.",
      "mode": "primary",
      "model": "omniroute/cx/gpt-5.6-luna",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "explorer": "allow",
          "worker": "allow",
          "general": "allow",
          "reviewer": "allow",
          "test-writer": "allow",
          "refactor": "allow",
          "bugfix": "allow",
          "verify": "allow"
        }
      }
    },
    "build": {
      "description": "Primary ship-sense (luna parity). L1–L2 self; verify before FINISH; spawn per spawn-hard.",
      "mode": "primary",
      "model": "omniroute/cx/gpt-5.6-luna",
      "color": "#3B82F6",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "explorer": "allow",
          "worker": "allow",
          "general": "allow",
          "reviewer": "allow",
          "test-writer": "allow",
          "refactor": "allow",
          "bugfix": "allow",
          "verify": "allow"
        }
      }
    },
    "luna": {
      "description": "Parent PLAN/IMPLEMENT — luna. L1–L2 self; verify before FINISH; spawn only per spawn-hard.",
      "mode": "primary",
      "model": "omniroute/cx/gpt-5.6-luna",
      "color": "#6366F1",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "explorer": "allow",
          "worker": "allow",
          "general": "allow",
          "reviewer": "allow",
          "test-writer": "allow",
          "refactor": "allow",
          "bugfix": "allow",
          "verify": "allow"
        }
      }
    },
    "grok": {
      "description": "Parent PLAN/IMPLEMENT — grok. L1–L2 self; verify before FINISH; spawn only per spawn-hard.",
      "mode": "primary",
      "model": "omniroute/gc/grok-build",
      "color": "#F59E0B",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "explorer": "allow",
          "worker": "allow",
          "general": "allow",
          "reviewer": "allow",
          "test-writer": "allow",
          "refactor": "allow",
          "bugfix": "allow",
          "verify": "allow"
        }
      }
    },
    "glm": {
      "description": "Parent PLAN/IMPLEMENT — glm. L1–L2 self; verify before FINISH; spawn only per spawn-hard.",
      "mode": "primary",
      "model": "omniroute/glm/glm-5.2",
      "color": "#10B981",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "explorer": "allow",
          "worker": "allow",
          "general": "allow",
          "reviewer": "allow",
          "test-writer": "allow",
          "refactor": "allow",
          "bugfix": "allow",
          "verify": "allow"
        }
      }
    },
    "flash": {
      "description": "Cheap parent — flash-high. L1–L2 self; verify before FINISH; spawn only per spawn-hard.",
      "mode": "primary",
      "model": "omniroute/antigravity/gemini-3.5-flash-high",
      "color": "#22D3EE",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "explorer": "allow",
          "worker": "allow",
          "general": "allow",
          "reviewer": "allow",
          "test-writer": "allow",
          "refactor": "allow",
          "bugfix": "allow",
          "verify": "allow"
        }
      }
    },
    "explore": {
      "description": "Explore via graphify only (grep/glob denied). Flash-low.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-low",
      "color": "#94A3B8",
      "steps": 18,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "grep": "deny",
        "glob": "deny",
        "bash": {
          "*": "deny",
          ".venv/bin/graphify *": "allow",
          "ls *": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "head *": "allow",
          "wc *": "allow"
        },
        "task": { "*": "deny" }
      }
    },
    "explorer": {
      "description": "Alias explore — graphify only, grep/glob denied. Flash-low.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-low",
      "color": "#94A3B8",
      "steps": 18,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "grep": "deny",
        "glob": "deny",
        "bash": {
          "*": "deny",
          ".venv/bin/graphify *": "allow",
          "ls *": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "head *": "allow",
          "wc *": "allow"
        },
        "task": { "*": "deny" }
      }
    },
    "general": {
      "description": "Worker flash-low. ≤5 files. ≤8 reads. No plan/workflow.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-low",
      "color": "#A78BFA",
      "steps": 12,
      "permission": {
        "task": { "*": "deny" },
        "bash": {
          "npm test*": "deny",
          "pnpm test*": "deny",
          "yarn test*": "deny",
          "npx vitest*": "deny",
          "vitest*": "deny",
          "npx playwright*": "deny",
          "playwright*": "deny",
          "npm run test*": "deny",
          "pnpm run test*": "deny"
        }
      }
    },
    "worker": {
      "description": "Alias general. ≤5 files. ≤8 reads. Packed AC only.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-low",
      "color": "#A78BFA",
      "steps": 12,
      "permission": {
        "task": { "*": "deny" },
        "bash": {
          "npm test*": "deny",
          "pnpm test*": "deny",
          "yarn test*": "deny",
          "npx vitest*": "deny",
          "vitest*": "deny",
          "npx playwright*": "deny",
          "playwright*": "deny",
          "npm run test*": "deny",
          "pnpm run test*": "deny"
        }
      }
    },
    "reviewer": {
      "description": "Review flash-high. ≤10 reads. Text-only finish.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-high",
      "color": "#FB7185",
      "steps": 18,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "rg *": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "ls *": "allow"
        },
        "task": { "*": "deny" }
      }
    },
    "test-writer": {
      "description": "TDD test-writer. Red first. Flash-low.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-low",
      "color": "#FBBF24",
      "steps": 14,
      "permission": {
        "task": { "*": "deny" },
        "bash": {
          "npm test*": "deny",
          "pnpm test*": "deny",
          "yarn test*": "deny",
          "npx vitest*": "deny",
          "vitest*": "deny",
          "npx playwright*": "deny",
          "playwright*": "deny",
          "npm run test*": "deny",
          "pnpm run test*": "deny"
        }
      }
    },
    "refactor": {
      "description": "Surgical multi-file refactor. Preserve behavior. Flash-low.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-low",
      "color": "#38BDF8",
      "steps": 14,
      "permission": {
        "task": { "*": "deny" },
        "bash": {
          "npm test*": "deny",
          "pnpm test*": "deny",
          "yarn test*": "deny",
          "npx vitest*": "deny",
          "vitest*": "deny",
          "npx playwright*": "deny",
          "playwright*": "deny",
          "npm run test*": "deny",
          "pnpm run test*": "deny"
        }
      }
    },
    "bugfix": {
      "description": "Root-cause bugfix. Reproduce → fix → prove. Flash-high.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-high",
      "color": "#F97316",
      "steps": 16,
      "permission": {
        "task": { "*": "deny" },
        "bash": {
          "npm test*": "deny",
          "pnpm test*": "deny",
          "yarn test*": "deny",
          "npx vitest*": "deny",
          "vitest*": "deny",
          "npx playwright*": "deny",
          "playwright*": "deny",
          "npm run test*": "deny",
          "pnpm run test*": "deny"
        }
      }
    },
    "verify": {
      "description": "Pre-FINISH verify. Read-only + VERIFY cmds. Text PASS/FAIL.",
      "mode": "subagent",
      "model": "omniroute/antigravity/gemini-3.5-flash-high",
      "color": "#84CC16",
      "steps": 12,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": { "*": "deny" },
        "bash": {
          "*": "deny",
          ".venv/bin/pytest *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "rg *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "wc *": "allow"
        }
      }
    }
  },
  "indexing": {
    "enabled": false,
    "provider": "kilo",
    "vectorStore": "lancedb",
    "lancedb": {},
    "fileExtensions": [".py", ".ts", ".tsx", ".sql", ".yaml", ".yml"],
    "searchMinScore": 0.45,
    "searchMaxResults": 20,
    "embeddingBatchSize": 40,
    "scannerMaxBatchRetries": 3
  }
}
